{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Friday",
  "version": "0.1.0",
  "identifier": "com.abrar.friday",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Friday",
        "width": 1050,
        "height": 600,
        "minWidth": 1000,
        "maxWidth": 1400,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../dist/FridayBackend/": "FridayBackend/",
      "../../backend/friday_modules/pdf_assistant_module/model/": "backend/friday_modules/pdf_assistant_module/model/",
      "../../backend/friday_modules/text_to_speech_module/Piper_TTS/": "backend/friday_modules/text_to_speech_module/Piper_TTS/"
    }
  }
}
